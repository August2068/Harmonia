{% extends 'base.html.twig' %}

{% block title %}Harmonia {{ album.title }}{% endblock %}

{% block body %}
    <div class="card" style="width: 50rem;">
        <img src="{{ asset(album.poster) }}" class="card-img-top" alt="...">
        <div class="card-body">
            <h5 class="card-title">{{ album.title }} - {{ duration|date('H:i:s') }}sec</h5>
            <span class="badge text-bg-secondary">{{ album.type }}</span>
            <p class="card-text">Artist : {{ album.artist.stageName }} - Released : {{ album.releasedAt|date('m/Y') }}</p>
            <p class="card-text">Number of tracks : {{ album.tracks|length }}</p>
            <a href="{{ path('app_artist_item', {'id': album.artist.id}) }}" class="btn btn-primary">Artist Page</a>
            <a href="{{ path('app_track_add', {'id': album.id}) }}" class="btn btn-primary">Add Track</a>
            <ul>
                {% for track in album.tracks %}
                    <li><a href="{{ path('app_track_item', {'id': track.id}) }}">{{ track.title }}</a> : {{ track.duration|date('i:s') }}sec</li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}
