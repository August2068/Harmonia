{% extends 'base.html.twig' %}

{% block title %}Harmonia {{ album.title }} edit{% endblock %}

{% block body %}
    <h1>{{ album.artist.stageName }}</h1>
    <h2>{{ album.title }}</h2>
    {{ form_start(form) }}
    <div>
        {{ form_row(form.title) }}
        {{ form_row(form.duration) }}
        {{ form_row(form.number) }}
        {{ form_row(form.isExplicit) }}
        {{ form_row(form.genres) }}
    </div>
    <button type="submit">Add Track</button>
    {{ form_end(form) }}
{% endblock %}
