{% extends 'base.html.twig' %}

{% block title %}Harmonia Playlist{% endblock %}

{% block body %}
    {{ form_start(form) }}
    <div>
        {{ form_row(form.name) }}
        {{ form_row(form.description) }}
        {{ form_row(form.isPublic) }}
    </div>
    <button type="submit">Create Playlist</button>
    {{ form_end(form) }}
{% endblock %}
