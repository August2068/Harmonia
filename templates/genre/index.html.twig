{% extends 'base.html.twig' %}

{% block title %}Harmonia {{genre.name}}{% endblock %}

{% block body %}
<h1>{{genre.name}}</h1>
<ul>
    {% for track in genre.tracks %}
        <li><a href="{{ path('app_track_item',{'id':track.id}) }}">{{track.title}}</a></li>
    {% endfor %}
</ul>
{% endblock %}
