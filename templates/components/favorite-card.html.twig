<div class="card w-75 mb-3">
    <div class="card-body">
        <h5 class="card-title">{{ track.title }}</h5>
        {% if type === "fav" %}
            <p>Created : {{ item.createdAt|date("m/Y") }}</p>
        {% else %}
            <p>Listened :  {{ item.createdAt|date("d/m/Y") }}</p>
        {% endif %}
        <p class="card-text">{{ track.album.artist.stageName }}</p>
        <a href="{{ path('app_track_item', {'id': track.id}) }}" class="btn btn-primary">Track page</a>
    </div>
</div>
