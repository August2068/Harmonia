{% extends 'base.html.twig' %}

{% block title %}Harmonia {{ artist.stageName }}{% endblock %}

{% block body %}
    <div class="container">
        <h2>{{ artist.stageName }}</h2>
        <div class="row">
            {% for album in artist.albums %}
                <div class="col-3 mb-2">
                    <div class="card shadow" style="width: 18rem;">
                        <img src="{{ asset(album.poster) }}" class="card-img-top" alt="...">
                        <div class="card-body">
                            <h5 class="card-title">{{ album.title }}</h5>
                            <span class="badge text-bg-secondary">{{ album.type }}</span>
                            <p class="card-text">Artist : {{ album.artist.stageName }}</p>
                            <p class="card-text">Number of tracks : {{ album.tracks|length }}</p>
                            <a href="{{ path('app_album_item', {'id': album.id}) }}" class="btn btn-primary">{{ album.type }} page</a>
                            <a href="{{ path('app_album_edit', {'id': album.id}) }}" class="btn btn-primary">Edit Album</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
            <a href="{{ path('app_album_add', {'id': artist.id}) }}" class="btn btn-primary">Add Album</a>
        </div>
    </div>
{% endblock %}
